generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id
  name               String
  email              String
  password           String
  isAdmin            Boolean
  whatsapp           String?
  deleted            Boolean
  UserToServiceOrder UserToServiceOrder[]
  UserToSector       UserToSector[]
}

model ServiceOrder {
  id                 String               @id
  title              String
  description        String
  sector             Sector               @relation(fields: [toSectorId], references: [id])
  toSectorId         String
  status             String
  createdAt          DateTime
  attributedAt       DateTime?
  closedAt           DateTime?
  deleted            Boolean
  UserToServiceOrder UserToServiceOrder[]
}

model Sector {
  id           String         @id
  name         String
  deleted      Boolean
  UserToSector UserToSector[]
  ServiceOrder ServiceOrder[]
}

model UserToServiceOrder {
  id             String       @id
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  serviceOrderId String
  deleted        Boolean
}

model UserToSector {
  id       String  @id
  user     User    @relation(fields: [userId], references: [id])
  userId   String
  sector   Sector  @relation(fields: [sectorId], references: [id])
  sectorId String
  deleted  Boolean
}
